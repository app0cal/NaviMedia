# Host path that Navidrome scans for music.
NAVIDROME_MUSIC_ROOT=/media

# Host account that should own files created through bind mounts.
PUID=1000
PGID=1000

# Downloader-owned persistent state.
MEDIA_DL_STATE=./state
MEDIA_DL_QUEUE=./queue
MEDIA_DL_DOWNLOADS=./downloads
NAVIMEDIA_CONFIG=./config
SERVICE_PORT=8765
